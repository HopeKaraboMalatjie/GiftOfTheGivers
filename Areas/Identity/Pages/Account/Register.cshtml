@page
@model GiftOfTheGivers.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container account-container py-5">
    <div class="account-card account-card-register">
        <aside class="account-aside" aria-label="The impact of your support">
            <span class="account-eyebrow">Give hope. Change lives.</span>
            <h1>Be part of something bigger.</h1>
            <p>Create your donor account to make it easier to stay connected to the causes and communities you support.</p>
            <div class="account-promise"><span aria-hidden="true">♡</span> Compassion in action, together.</div>
        </aside>
        <section class="account-content" aria-labelledby="account-title">
            <span class="account-kicker">Join our community</span>
            <h2 id="account-title">Create your account</h2>
            <p class="account-intro">A few details are all it takes to get started.</p>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger account-validation" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                    <input asp-for="Input.FullName" class="form-control account-input" autocomplete="name" autofocus />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email address</label>
                    <input asp-for="Input.Email" class="form-control account-input" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Create a password</label>
                    <input asp-for="Input.Password" class="form-control account-input" autocomplete="new-password" aria-describedby="password-guidance" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                    <div id="password-guidance" class="form-text">Use at least 8 characters.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control account-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-gotg-primary account-submit">Create donor account</button>
            </form>

            <p class="account-switch">Already have an account? <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
            <p class="account-guest">Prefer not to create an account? <a asp-controller="Donation" asp-action="Create">Donate as a guest</a>.</p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
