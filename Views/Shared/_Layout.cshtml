<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gotg-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="gotg-logo-mark">GG</span>
                    <span>Gift of the Givers</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donation" asp-action="Create">Donate</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Volunteer" asp-action="Create">Volunteer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employee" asp-action="Dashboard">Employee Dashboard</a></li>
                        }
                        <li class="nav-item">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <form class="d-flex" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out (@User.Identity.Name)</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Log in</a>
                                <a class="btn btn-outline-light btn-sm ms-1" asp-area="Identity" asp-page="/Account/Register">Register</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-shrink-0">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success">@TempData["Success"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="gotg-footer text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year Gift of the Givers Foundation &mdash; Prototype System</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
