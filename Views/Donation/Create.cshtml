@model Donation
@{
    ViewData["Title"] = "Donate";
    var projects = ViewBag.Projects as List<ReliefProject>;
}

<div class="container py-5" style="max-width:600px;">
    <h2 class="section-title mb-4">Make a Donation</h2>

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info">You're donating as an anonymous guest. <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to track your donation history.</div>
    }

    <form asp-controller="Donation" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="guestName" class="form-control" placeholder="Anonymous Donor" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email (for your certificate)</label>
                <input type="email" name="guestEmail" class="form-control" />
            </div>
        }

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">Amount</label>
            <input asp-for="Amount" class="form-control" placeholder="e.g. 500" required />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Currency" class="form-label">Currency</label>
            <select asp-for="Currency" class="form-select">
                <option value="ZAR">ZAR (South African Rand)</option>
                <option value="USD">USD (US Dollar)</option>
                <option value="EUR">EUR (Euro)</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Frequency" class="form-label">Frequency</label>
            <select asp-for="Frequency" class="form-select">
                <option value="OneTime">One-time</option>
                <option value="Recurring">Recurring (monthly)</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ReliefProjectId" class="form-label">Support a specific project (optional)</label>
            <select asp-for="ReliefProjectId" class="form-select">
                <option value="">General Fund</option>
                @if (projects != null)
                {
                    foreach (var p in projects)
                    {
                        <option value="@p.ReliefProjectId">@p.Title</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-gotg-primary w-100">Donate</button>
    </form>
</div>
