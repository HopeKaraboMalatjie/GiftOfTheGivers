<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>GiftOfTheGivers.Helpers</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gift of the Givers POE Team</Authors>
    <Description>Shared helper utilities for the Gift of the Givers Foundation web application, including tax certificate number formatting and donation total calculations.</Description>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>
  </PropertyGroup>

</Project>
