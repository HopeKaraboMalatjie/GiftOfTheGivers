<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	<PackageId>GiftOfTheGivers.Helpers</PackageId>
	<Version>1.0.0</Version>
	<Authors>Gift of the Givers Foundation</Authors>
	<Description>Reusable donation and certificate formatting helpers for the Gift of the Givers prototype.</Description>
	<RepositoryUrl>https://github.com/HopeKaraboMalatjie/GiftOfTheGivers</RepositoryUrl>
	<PackageTags>donations;certificates;gift-of-the-givers</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tamp.AzureFunctionsCoreTools.V4" Version="0.1.1" />
  </ItemGroup>
  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
